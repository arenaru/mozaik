# Copy to .env and change every password. Never commit .env.
# Use letters, digits, '-' and '_' only for passwords (they are passed through shell/SQL init scripts).

APP_ENV=development
APP_URL=http://localhost:8080
# Set to 1 when the app is served over HTTPS (session cookie gets the Secure flag).
COOKIE_SECURE=0

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mozaic

# Least-privilege account used by the PHP app (SELECT/INSERT/UPDATE/DELETE only).
APP_DB_USER=mozaic_app
APP_DB_PASSWORD=change-me-app
